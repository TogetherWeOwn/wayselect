#!/usr/bin/env node
// TOG-6336 (TOG-5735 impl slice): large-catalog refresh benchmark budget.
//
// Stdlib only, no network, no credentials. Times the perf paths exercised by
// test/large-catalog-benchmark.test.js over fixtures/catalog.large-synthetic.json
// (~2000 routes, generated by scripts/generate-large-catalog.mjs):
//   normalize  — normalizeCatalog (hash-verified catalog boundary)
//   searchIndex — buildSearchIndex
//   probe      — probeSearchIndexRefresh (build + rebuild + reload checks)
//   snapshot   — buildSnapshot x2 (base + small-delta variant)
//   diff       — diffSnapshots of the two snapshots
//
// Prints JSON { fixture, routeCount, timings, budget, ok } and exits non-zero
// when any stage exceeds its budget. Budgets are CI-safe (~5-10x local
// measurements); canonical table lives in docs/large-catalog-benchmark.md —
// keep the two in sync.
//
// Usage:
//   node bin/benchmark-large-catalog [--catalog <path>]

import { readFile } from "node:fs/promises";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { computeCatalogSnapshotHash, normalizeCatalog } from "../src/catalog.js";
import { buildSearchIndex, probeSearchIndexRefresh } from "../src/searchIndex.js";
import { buildSnapshot } from "../src/snapshot.js";
import { diffSnapshots } from "../src/catalogDiff.js";
import { generateLargeCatalog } from "../scripts/generate-large-catalog.mjs";

const HERE = dirname(fileURLToPath(import.meta.url));
const DEFAULT_CATALOG = resolve(HERE, "..", "fixtures", "catalog.large-synthetic.json");

// Stage budgets in ms. Generous vs local measurements (see docs page);
// keep in sync with test/large-catalog-benchmark.test.js.
export const LARGE_CATALOG_BUDGETS_MS = Object.freeze({
  normalize: 250,
  searchIndex: 300,
  probe: 1000,
  snapshot: 1000,
  diff: 100,
});

function parseCatalog(argv) {
  for (let i = 0; i < argv.length; i += 1) {
    if (argv[i] === "--catalog") {
      const value = argv[i + 1];
      if (!value) {
        throw new Error("missing value for --catalog");
      }
      return resolve(value);
    }
  }
  return DEFAULT_CATALOG;
}

function timed(fn) {
  const start = process.hrtime.bigint();
  const result = fn();
  const elapsedMs = Number(process.hrtime.bigint() - start) / 1e6;
  return { result, elapsedMs };
}

async function loadFixture(path) {
  try {
    return JSON.parse(await readFile(path, "utf8"));
  } catch {
    // Fixture not checked out (or path overridden): fall back to the
    // deterministic in-memory generator so the benchmark still runs.
    const generated = generateLargeCatalog();
    return { provenance: generated.provenance, catalog: generated.catalog };
  }
}

// Small-delta variant: one renamed model (changed) + one added model (added)
// so the diff stage exercises non-empty paths. The hash is recomputed so the
// variant still verifies at the catalog boundary.
function withSmallDelta(catalogInput, provenanceInput) {
  const catalog = structuredClone(catalogInput);
  const providerIds = Object.keys(catalog).sort();
  const firstProvider = catalog[providerIds[0]];
  const firstModelId = Object.keys(firstProvider.models).sort()[0];
  firstProvider.models[firstModelId] = {
    ...firstProvider.models[firstModelId],
    name: `${firstProvider.models[firstModelId].name} (delta)`,
  };
  const lastProvider = catalog[providerIds[providerIds.length - 1]];
  lastProvider.models["stress-model-delta"] = {
    id: "stress-model-delta",
    name: "Delta Model",
    attachment: false,
    reasoning: false,
    tool_call: true,
    structured_output: false,
    modalities: { input: ["text"], output: ["text"] },
    context_window: 32768,
    max_output_tokens: 4096,
    cost: { input: 1, output: 2 },
  };
  const provenance = {
    ...provenanceInput,
    snapshotHash: computeCatalogSnapshotHash(catalog),
  };
  return { catalog, provenance };
}

export async function runBenchmark(argv = process.argv.slice(2)) {
  const catalogPath = parseCatalog(argv);
  const fixture = await loadFixture(catalogPath);
  const { catalog: catalogInput, provenance: provenanceInput } = fixture;

  const timings = {};

  const normalized = timed(() => normalizeCatalog(catalogInput, provenanceInput));
  timings.normalizeMs = normalized.elapsedMs;

  const indexed = timed(() => buildSearchIndex(catalogInput, provenanceInput));
  timings.searchIndexMs = indexed.elapsedMs;

  const probed = timed(() => probeSearchIndexRefresh(catalogInput, provenanceInput));
  timings.probeMs = probed.elapsedMs;
  if (!probed.result.ok) {
    throw new Error("probeSearchIndexRefresh failed on the large fixture");
  }

  const delta = withSmallDelta(catalogInput, provenanceInput);
  const snapshotted = timed(() => ({
    base: buildSnapshot(catalogInput, provenanceInput),
    next: buildSnapshot(delta.catalog, delta.provenance),
  }));
  timings.snapshotMs = snapshotted.elapsedMs;

  const diffed = timed(() =>
    diffSnapshots(snapshotted.result.base, snapshotted.result.next),
  );
  timings.diffMs = diffed.elapsedMs;
  timings.totalMs =
    timings.normalizeMs +
    timings.searchIndexMs +
    timings.probeMs +
    timings.snapshotMs +
    timings.diffMs;

  const failures = Object.entries(LARGE_CATALOG_BUDGETS_MS)
    .filter(([stage]) => timings[`${stage}Ms`] > LARGE_CATALOG_BUDGETS_MS[stage])
    .map(
      ([stage]) =>
        `${stage} took ${timings[`${stage}Ms`].toFixed(1)}ms, budget ${LARGE_CATALOG_BUDGETS_MS[stage]}ms`,
    );

  return {
    fixture: catalogPath,
    routeCount: normalized.result.entries.length,
    diff: {
      added: diffed.result.summary.addedCount,
      changed: diffed.result.summary.changedCount,
    },
    timings: Object.fromEntries(
      Object.entries(timings).map(([key, value]) => [key, Math.round(value * 10) / 10]),
    ),
    budget: { ...LARGE_CATALOG_BUDGETS_MS },
    ok: failures.length === 0,
    failures,
  };
}

// Import-safe: the CLI body runs only when executed directly, so the test can
// import LARGE_CATALOG_BUDGETS_MS without running the benchmark as a side effect.
const invokedAsCli =
  process.argv[1] !== undefined &&
  resolve(process.argv[1]) === fileURLToPath(import.meta.url);

if (invokedAsCli) {
  const report = await runBenchmark();
  console.log(JSON.stringify(report, null, 2));
  if (!report.ok) {
    console.error(`large-catalog benchmark OVER BUDGET: ${report.failures.join("; ")}`);
    process.exit(1);
  }
}
