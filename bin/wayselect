#!/usr/bin/env node

import { readFile, writeFile } from "node:fs/promises";
import { resolve } from "node:path";
import {
  DEFAULT_MODELS_DEV_SOURCE,
  FakeTransport,
  IngestError,
  applySupportConfiguration,
  compareRouteIds,
  hashRawText,
  ingestModelsDev,
  normalizeCatalog,
  normalizeRequirements,
  selectRoute,
} from "../src/index.js";
import {
  formatCliFailure,
  invalidMaxCatalogAgeMessage,
  missingValueMessage,
  unknownArgumentMessage,
} from "../src/cliErrors.js";

// ---------------------------------------------------------------------------
// Legacy demo path: bare `bin/wayselect [flags]` (no subcommand).
//
// Preserved verbatim so the fixture demo, the catalog-gate tests, the
// exact-byte failure-copy tests, and the QA acceptance scripts keep their
// pinned surface: JSON `{earlyDevelopment, mode, selection, transport,
// provenance}` on stdout, `<Name>: <message>\n` on stderr with exit code 1.
// ---------------------------------------------------------------------------

function parseArguments(argv) {
  const values = {
    catalog: "fixtures/catalog.synthetic.json",
    configuration: "fixtures/configuration.synthetic.json",
    request: "fixtures/request.synthetic.json",
    maxCatalogAgeHours: null,
  };

  for (let index = 0; index < argv.length; index += 2) {
    const flag = argv[index];
    const value = argv[index + 1];
    if (!value) {
      throw new Error(missingValueMessage(flag));
    }
    if (flag === "--catalog") {
      values.catalog = value;
    } else if (flag === "--configuration") {
      values.configuration = value;
    } else if (flag === "--request") {
      values.request = value;
    } else if (flag === "--max-catalog-age-hours") {
      const parsed = Number(value);
      if (!Number.isFinite(parsed) || parsed < 0) {
        throw new Error(invalidMaxCatalogAgeMessage());
      }
      values.maxCatalogAgeHours = parsed;
    } else {
      throw new Error(unknownArgumentMessage(flag));
    }
  }

  return values;
}

async function readJson(path) {
  return JSON.parse(await readFile(resolve(path), "utf8"));
}

// TOG-4791: opt-in catalog ingestion. `catalog` is the only multi-word entry
// point; every other argv shape keeps the surrounding select/explain and
// legacy paths byte-identical so the cli-errors pins keep holding.
function parseCatalogImportArgs(tokens) {
  if (tokens.length === 0 || tokens[0] === "--help") {
    return { help: true };
  }
  if (tokens[0] !== "import") {
    throw new Error(unknownArgumentMessage(tokens[0]));
  }
  const options = {
    file: null,
    fetch: false,
    fetchUrl: DEFAULT_MODELS_DEV_SOURCE,
    source: undefined,
    snapshotTimestamp: undefined,
    snapshotHash: undefined,
    out: null,
    json: false,
    help: false,
  };
  const valueFlags = new Set([
    "--fetch-url",
    "--source",
    "--snapshot-timestamp",
    "--snapshot-hash",
    "--out",
  ]);
  // TOG-8455: track an explicit --fetch-url so a file-mode import carrying
  // one fails closed instead of silently ignoring the URL override.
  let fetchUrlProvided = false;
  for (let index = 1; index < tokens.length; index += 1) {
    const token = tokens[index];
    if (token === "--fetch") {
      options.fetch = true;
      continue;
    }
    if (token === "--json") {
      options.json = true;
      continue;
    }
    if (token === "--help") {
      options.help = true;
      continue;
    }
    if (valueFlags.has(token)) {
      const value = tokens[index + 1];
      if (value === undefined || value.startsWith("--")) {
        throw new Error(missingValueMessage(token));
      }
      if (token === "--fetch-url") {
        options.fetchUrl = value;
        fetchUrlProvided = true;
      } else if (token === "--source") {
        options.source = value;
      } else if (token === "--snapshot-timestamp") {
        options.snapshotTimestamp = value;
      } else if (token === "--snapshot-hash") {
        options.snapshotHash = value;
      } else {
        options.out = value;
      }
      index += 1;
      continue;
    }
    if (token.startsWith("--")) {
      throw new Error(unknownArgumentMessage(token));
    }
    if (options.file !== null) {
      throw new Error("catalog import takes a single input file");
    }
    options.file = token;
  }
  // TOG-8455: fail closed when --fetch-url is given without --fetch so a
  // typo'd fetch URL can never look like it took effect. --help still
  // short-circuits to usage.
  if (fetchUrlProvided && !options.fetch && !options.help) {
    throw new Error("--fetch-url requires --fetch");
  }
  if (options.file !== null && options.fetch) {
    throw new Error("catalog import takes either a file or --fetch, not both");
  }
  if (!options.help && options.file === null && !options.fetch) {
    throw new Error("catalog import needs an input file or --fetch");
  }
  return { subcommand: "import", ...options };
}

async function fetchModelsDevText(url) {
  // The ONLY networked path in this CLI: explicit opt-in via --fetch, never
  // exercised in tests.
  let response;
  try {
    response = await globalThis.fetch(url);
  } catch (error) {
    throw new IngestError(`Cannot fetch ${url}: ${error.message}`);
  }
  if (!response.ok) {
    throw new IngestError(`Cannot fetch ${url}: HTTP ${response.status}`);
  }
  return response.text();
}

async function runCatalogImport(options) {
  const rawText = options.fetch
    ? await fetchModelsDevText(options.fetchUrl)
    : await readFile(resolve(options.file), "utf8").catch((error) => {
        throw new IngestError(`Cannot read ${options.file}: ${error.message}`);
      });
  let input;
  try {
    input = JSON.parse(rawText);
  } catch (error) {
    throw new IngestError(
      `Cannot parse ${options.fetch ? options.fetchUrl : options.file} as JSON: ${error.message}`,
    );
  }

  const source =
    options.source ?? (options.fetch ? options.fetchUrl : `file://${resolve(options.file)}`);
  const ingested = ingestModelsDev(input, {
    source,
    snapshotTimestamp: options.snapshotTimestamp,
    snapshotHash: options.snapshotHash,
  });

  const catalog = normalizeCatalog(ingested.catalog, ingested.provenance);
  if (catalog.entries.length === 0) {
    const reasons = ingested.quarantined.map((entry) => `${entry.routeId}: ${entry.reason}`);
    throw new IngestError(
      `No entries survived ingestion${reasons.length > 0 ? `: ${reasons.join("; ")}` : ""}`,
    );
  }

  const document = { provenance: ingested.provenance, catalog: ingested.catalog };
  let outPath = null;
  if (options.out !== null) {
    outPath = resolve(options.out);
    await writeFile(outPath, `${JSON.stringify(document, null, 2)}\n`).catch((error) => {
      throw new IngestError(`Cannot write ${options.out}: ${error.message}`);
    });
  }

  const summary = {
    command: "catalog import",
    // TOG-8326: in-band machine-schema version, same marker as the
    // select/explain shape (const: v1 in schema/cli-json/v1.json).
    schemaVersion: "v1",
    dryRun: true,
    networkUsed: options.fetch,
    source: ingested.provenance.source,
    snapshotTimestamp: ingested.provenance.snapshotTimestamp,
    snapshotHash: ingested.provenance.snapshotHash,
    rawHash: hashRawText(rawText),
    providerCount: Object.keys(ingested.catalog).length,
    entryCount: catalog.entries.length,
    quarantined: ingested.quarantined.map((entry) => ({ ...entry })),
    outPath,
  };
  if (options.json) {
    process.stdout.write(`${JSON.stringify(summary, null, 2)}\n`);
    return;
  }
  const lines = [
    "catalog import — dry-run only (support state: catalogued only)",
    `Source: ${summary.source} @ ${summary.snapshotTimestamp}`,
    `Snapshot hash: ${summary.snapshotHash}`,
    `Raw input hash: ${summary.rawHash}`,
    `Ingested ${summary.entryCount} entr${summary.entryCount === 1 ? "y" : "ies"} ` +
      `from ${summary.providerCount} provider${summary.providerCount === 1 ? "" : "s"} ` +
      `(support state: catalogued only).`,
  ];
  if (summary.quarantined.length > 0) {
    lines.push(`Quarantined ${summary.quarantined.length}:`);
    for (const entry of summary.quarantined) {
      lines.push(`  - ${entry.routeId}: ${entry.reason}`);
    }
  }
  if (outPath !== null) {
    lines.push(`Wrote catalog document: ${outPath}`);
  } else {
    lines.push("No --out path given; catalog document not written.");
  }
  process.stdout.write(`${lines.join("\n")}\n`);
}

function printCatalogImportHelp() {
  process.stdout.write(
    `wayselect catalog import — ingest models.dev-shaped JSON into a catalog document (dry-run only)

Usage:
  wayselect catalog import <file> [options]   Read a local models.dev-shaped JSON file
  wayselect catalog import --fetch [options]  Fetch ${DEFAULT_MODELS_DEV_SOURCE} (only networked path)

Options:
  --fetch-url <url>              Override the fetch URL (only with --fetch)
  --source <label>               Override the provenance source label
  --snapshot-timestamp <iso>     Override the provenance snapshot timestamp
  --snapshot-hash <sha256:...>   Override the provenance snapshot hash (must match the ingested body)
  --out <path>                   Write the ingested catalog document to <path>
  --json                         Machine-readable JSON summary
  --help                         Show this help

Every ingested entry lands as support state catalogued only — ingestion never
configures, enables, or produces executable URLs. Unknown or malformed fields
are quarantined with reasons; missing capabilities are never guessed.
`,
  );
}

async function runLegacyDemo(argv) {
  const paths = parseArguments(argv);
  const [catalogFixture, configuration, demoRequest] = await Promise.all([
    readJson(paths.catalog),
    readJson(paths.configuration),
    readJson(paths.request),
  ]);

  const catalog = normalizeCatalog(catalogFixture.catalog, catalogFixture.provenance);
  const candidates = applySupportConfiguration(catalog, configuration);
  // TOG-5117: explicit --max-catalog-age-hours wins; otherwise honor the
  // request field; fall back to 24h. Expired snapshots fail closed in
  // evaluateEligibility (stale-catalog/future-catalog, no transport).
  const maxCatalogAgeHours =
    paths.maxCatalogAgeHours ?? demoRequest.maxCatalogAgeHours ?? 24;
  const result = selectRoute(candidates, demoRequest.selection, {
    now: new Date(demoRequest.evaluationTime),
    maxEvidenceAgeMs: demoRequest.maxEvidenceAgeHours * 60 * 60 * 1000,
    catalog,
    maxCatalogAgeMs: maxCatalogAgeHours * 60 * 60 * 1000,
  });

  let transport = null;
  if (result.selected) {
    const fake = new FakeTransport();
    transport = await fake.send({
      route: result.selected,
      payload: demoRequest.syntheticPayload,
    });
  }

  process.stdout.write(
    `${JSON.stringify(
      {
        earlyDevelopment: true,
        mode: "dry-run-only",
        provenance: catalog.provenance,
        selection: result,
        transport,
      },
      null,
      2,
    )}\n`,
  );
}

// ---------------------------------------------------------------------------
// select/explain UX (TOG-4797): subcommands with human and --json output,
// requirement flags or a request file, and exit codes 0/1/2/3.
// The catalog freshness gate is wired exactly like the legacy path:
// explicit --max-catalog-age-hours wins, otherwise the request field,
// otherwise 24h. Stale/future catalogs yield no-eligible-route (exit 3),
// never a selection.
// ---------------------------------------------------------------------------

const EXIT_OK = 0;
const EXIT_INVALID_INPUT = 1;
const EXIT_USAGE = 2;
const EXIT_NO_ELIGIBLE_ROUTE = 3;

const DRY_RUN_LABEL =
  "dry-run / synthetic estimate — no live model calls, credentials, or network use";

const DEFAULT_PATHS = Object.freeze({
  catalog: "fixtures/catalog.synthetic.json",
  configuration: "fixtures/configuration.synthetic.json",
  request: "fixtures/request.synthetic.json",
});

const DEFAULT_MAX_EVIDENCE_AGE_HOURS = 72;
const DEFAULT_MAX_CATALOG_AGE_HOURS = 24;

class UsageError extends Error {
  constructor(message) {
    super(message);
    this.name = "UsageError";
  }
}

class InputError extends Error {
  constructor(message) {
    super(message);
    this.name = "InputError";
  }
}

const VALUE_FLAGS = new Set([
  "--catalog",
  "--configuration",
  "--request",
  "--operation",
  "--evaluation-time",
  "--max-evidence-age-hours",
  "--max-catalog-age-hours",
  "--min-context-window",
  "--max-output-tokens",
]);

const LIST_FLAGS = new Set([
  "--require",
  "--allow",
  "--input-modalities",
  "--output-modalities",
]);

// TOG-5857 (S1): typed-requirement boolean flags. Opt-in only — absent means
// "no constraint", matching the library's `false means no constraint` rule.
const REQUIREMENT_BOOLEAN_FLAGS = new Set([
  "--require-tools",
  "--require-structured-output",
  "--require-reasoning",
]);

function usageError(message) {
  return new UsageError(`${message}\nRun "wayselect --help" for usage.`);
}

function splitListFlag(value, flag) {
  const items = value
    .split(",")
    .map((item) => item.trim())
    .filter((item) => item !== "");
  if (items.length === 0) {
    throw usageError(`${flag} must list at least one value`);
  }
  return [...new Set(items)];
}

function parseCommandArgs(tokens, command) {
  const options = {
    catalog: DEFAULT_PATHS.catalog,
    configuration: DEFAULT_PATHS.configuration,
    request: null,
    operation: undefined,
    require: [],
    allow: [],
    inputModalities: [],
    outputModalities: [],
    minContextWindow: undefined,
    maxOutputTokens: undefined,
    requireTools: undefined,
    requireStructuredOutput: undefined,
    requireReasoning: undefined,
    evaluationTime: undefined,
    maxEvidenceAgeHours: undefined,
    maxCatalogAgeHours: undefined,
    json: false,
    help: false,
  };

  for (let index = 0; index < tokens.length; index += 1) {
    const token = tokens[index];
    if (token === "--json") {
      options.json = true;
      continue;
    }
    if (token === "--help") {
      options.help = true;
      continue;
    }
    if (REQUIREMENT_BOOLEAN_FLAGS.has(token)) {
      if (token === "--require-tools") {
        options.requireTools = true;
      } else if (token === "--require-structured-output") {
        options.requireStructuredOutput = true;
      } else {
        options.requireReasoning = true;
      }
      continue;
    }
    if (LIST_FLAGS.has(token)) {
      const value = tokens[index + 1];
      if (!value || value.startsWith("--")) {
        throw usageError(`Missing value for ${token}`);
      }
      const items = splitListFlag(value, token);
      if (token === "--require") {
        options.require.push(...items);
      } else if (token === "--allow") {
        options.allow.push(...items);
      } else if (token === "--input-modalities") {
        options.inputModalities.push(...items);
      } else {
        options.outputModalities.push(...items);
      }
      index += 1;
      continue;
    }
    if (VALUE_FLAGS.has(token)) {
      const value = tokens[index + 1];
      if (!value || value.startsWith("--")) {
        throw usageError(`Missing value for ${token}`);
      }
      if (token === "--catalog") {
        options.catalog = value;
      } else if (token === "--configuration") {
        options.configuration = value;
      } else if (token === "--request") {
        options.request = value;
      } else if (token === "--operation") {
        options.operation = value;
      } else if (token === "--evaluation-time") {
        options.evaluationTime = value;
      } else if (token === "--max-evidence-age-hours") {
        options.maxEvidenceAgeHours = value;
      } else if (token === "--max-catalog-age-hours") {
        options.maxCatalogAgeHours = value;
      } else if (token === "--min-context-window") {
        options.minContextWindow = value;
      } else if (token === "--max-output-tokens") {
        options.maxOutputTokens = value;
      }
      index += 1;
      continue;
    }
    if (token.startsWith("--")) {
      throw usageError(`Unknown flag for ${command}: ${token}`);
    }
    throw usageError(`Unexpected argument for ${command}: ${token}`);
  }

  return options;
}

async function readJsonFile(path) {
  let text;
  try {
    text = await readFile(resolve(path), "utf8");
  } catch (error) {
    throw new InputError(`Cannot read ${path}: ${error.message}`);
  }
  try {
    return JSON.parse(text);
  } catch (error) {
    throw new InputError(`Cannot parse ${path} as JSON: ${error.message}`);
  }
}

function parseMaxEvidenceAgeMs(raw, source) {
  const hours = raw === undefined ? DEFAULT_MAX_EVIDENCE_AGE_HOURS : Number(raw);
  if (!Number.isFinite(hours) || hours < 0) {
    throw new InputError(
      `${source} must be a non-negative number of hours, got: ${raw}`,
    );
  }
  return hours * 60 * 60 * 1000;
}

function parseMaxCatalogAgeMs(raw, source) {
  const hours = raw === undefined ? DEFAULT_MAX_CATALOG_AGE_HOURS : Number(raw);
  if (!Number.isFinite(hours) || hours < 0) {
    throw new InputError(invalidMaxCatalogAgeMessage());
  }
  return { maxCatalogAgeMs: hours * 60 * 60 * 1000, maxCatalogAgeHours: hours };
}

function parseEvaluationTime(raw) {
  if (raw === undefined || raw === null) {
    return new Date();
  }
  const time = raw instanceof Date ? raw : new Date(raw);
  if (!Number.isFinite(time.getTime())) {
    throw new InputError(`evaluation time must be an ISO timestamp, got: ${raw}`);
  }
  return time;
}

// TOG-5857 (S1): typed-requirement token thresholds. Fail-closed at the CLI
// boundary (exit 1) so a typo never silently becomes "no constraint"; the
// library's own boundary rejects malformed file values the same way.
function parseTokenThreshold(raw, flag) {
  if (raw === undefined) {
    return undefined;
  }
  const value = typeof raw === "number" ? raw : Number(raw);
  if (!Number.isInteger(value) || value < 0) {
    throw new InputError(`${flag} must be a non-negative integer, got: ${raw}`);
  }
  return value;
}

async function resolveSelectionInput(options) {
  let fileSelection = null;
  let fileEvaluationTime;
  let fileMaxEvidenceAgeHours;
  let fileMaxCatalogAgeHours;

  const wantsRequirementsFromFlags =
    options.inputModalities.length > 0 ||
    options.outputModalities.length > 0 ||
    options.minContextWindow !== undefined ||
    options.maxOutputTokens !== undefined ||
    options.requireTools !== undefined ||
    options.requireStructuredOutput !== undefined ||
    options.requireReasoning !== undefined;

  const wantsFileDefault =
    options.request === null &&
    options.operation === undefined &&
    options.require.length === 0 &&
    options.allow.length === 0 &&
    !wantsRequirementsFromFlags &&
    options.evaluationTime === undefined &&
    options.maxEvidenceAgeHours === undefined &&
    options.maxCatalogAgeHours === undefined;

  const requestPath = options.request ?? (wantsFileDefault ? DEFAULT_PATHS.request : null);
  if (requestPath !== null) {
    const raw = await readJsonFile(requestPath);
    if (raw !== null && typeof raw === "object" && !Array.isArray(raw) && "selection" in raw) {
      fileSelection = raw.selection ?? null;
      fileEvaluationTime = raw.evaluationTime;
      fileMaxEvidenceAgeHours = raw.maxEvidenceAgeHours;
      fileMaxCatalogAgeHours = raw.maxCatalogAgeHours;
    } else {
      fileSelection = raw;
    }
  }

  // TOG-5857 (S1): typed requirements ride along only when the file or
  // flags actually provide one — legacy file/flag combinations keep the
  // exact pre-S1 selection shape, so legacy behavior is untouched.
  const fileRequirements =
    fileSelection?.requirements !== undefined ? fileSelection.requirements : undefined;
  // TOG-5946 Blocking 1: validate the raw file requirements BEFORE merging
  // with flags. The per-dimension `?.`/`??` reads below would otherwise
  // silently drop an unknown key or a non-object value whenever any typed
  // flag is present (fail open). The library is the single source of truth
  // for the shape; rethrow as InputError so the CLI exits 1.
  if (fileRequirements !== undefined) {
    try {
      normalizeRequirements(fileRequirements);
    } catch (error) {
      throw new InputError(error.message);
    }
  }
  let requirements;
  if (wantsRequirementsFromFlags) {
    requirements = {
      inputModalities:
        options.inputModalities.length > 0
          ? [...new Set(options.inputModalities)].sort()
          : (fileRequirements?.inputModalities ?? []),
      outputModalities:
        options.outputModalities.length > 0
          ? [...new Set(options.outputModalities)].sort()
          : (fileRequirements?.outputModalities ?? []),
      minContextWindow:
        parseTokenThreshold(options.minContextWindow, "--min-context-window") ??
        (fileRequirements?.minContextWindow ?? undefined),
      maxOutputTokens:
        parseTokenThreshold(options.maxOutputTokens, "--max-output-tokens") ??
        (fileRequirements?.maxOutputTokens ?? undefined),
      toolCalling: options.requireTools ?? fileRequirements?.toolCalling ?? false,
      structuredOutput:
        options.requireStructuredOutput ?? fileRequirements?.structuredOutput ?? false,
      reasoning: options.requireReasoning ?? fileRequirements?.reasoning ?? false,
    };
  } else {
    requirements = fileRequirements;
  }

  const selection = {
    operation: options.operation ?? fileSelection?.operation,
    requiredCapabilities:
      options.require.length > 0
        ? [...new Set(options.require)].sort()
        : (fileSelection?.requiredCapabilities ?? []),
    providerAllowlist:
      options.allow.length > 0
        ? [...new Set(options.allow)].sort()
        : fileSelection?.providerAllowlist,
    ...(requirements === undefined ? {} : { requirements }),
  };

  if (selection.operation === undefined) {
    throw new InputError(
      "a request operation is required: pass --operation <name> or --request <path>",
    );
  }
  if (selection.providerAllowlist === undefined) {
    throw new InputError(
      "a provider allowlist is required: pass --allow <provider,...> or --request <path>",
    );
  }

  const evaluationTime = parseEvaluationTime(
    options.evaluationTime ?? fileEvaluationTime,
  );
  const maxEvidenceAgeMs = parseMaxEvidenceAgeMs(
    options.maxEvidenceAgeHours ?? fileMaxEvidenceAgeHours,
    options.maxEvidenceAgeHours !== undefined
      ? "--max-evidence-age-hours"
      : "request maxEvidenceAgeHours",
  );
  const maxEvidenceAgeHours = maxEvidenceAgeMs / (60 * 60 * 1000);
  const { maxCatalogAgeMs, maxCatalogAgeHours } = parseMaxCatalogAgeMs(
    options.maxCatalogAgeHours ?? fileMaxCatalogAgeHours,
    options.maxCatalogAgeHours !== undefined
      ? "--max-catalog-age-hours"
      : "request maxCatalogAgeHours",
  );

  return {
    selection,
    evaluationTime,
    maxEvidenceAgeMs,
    maxEvidenceAgeHours,
    maxCatalogAgeMs,
    maxCatalogAgeHours,
  };
}

function estimatedRatePerMillion(candidate) {
  if (!candidate.rates) {
    return null;
  }
  return candidate.rates.inputPerMillion + candidate.rates.outputPerMillion;
}

function rankCandidates(evaluations) {
  const eligible = evaluations
    .filter((candidate) => candidate.eligible)
    .sort((left, right) => {
      const leftRate = estimatedRatePerMillion(left);
      const rightRate = estimatedRatePerMillion(right);
      if (leftRate !== null && rightRate !== null && leftRate !== rightRate) {
        return leftRate - rightRate;
      }
      if (leftRate !== null && rightRate === null) {
        return -1;
      }
      if (leftRate === null && rightRate !== null) {
        return 1;
      }
      return compareRouteIds(left.routeId, right.routeId);
    });
  const excluded = evaluations.filter((candidate) => !candidate.eligible);
  return [...eligible, ...excluded];
}

function formatRate(candidate) {
  const rate = estimatedRatePerMillion(candidate);
  return rate === null ? "no rate data" : `est. ${rate} / million tokens`;
}

function formatSelectHuman({ result, ranked, provenance }) {
  const eligibleCount = ranked.filter((candidate) => candidate.eligible).length;
  const lines = [
    `dry-run select — ${DRY_RUN_LABEL}`,
    result.status === "selected"
      ? `Selected route: ${result.selected.routeId}`
      : "No eligible route.",
    `Policy: ${result.policy}`,
    "Rates are synthetic/list-price estimates only; not actual cost or savings.",
    "",
    `Ranked candidates (${eligibleCount} eligible, ${ranked.length - eligibleCount} excluded):`,
  ];
  ranked.forEach((candidate, index) => {
    if (candidate.eligible) {
      lines.push(`  ${index + 1}. ${candidate.routeId} — eligible, ${formatRate(candidate)}`);
    } else {
      lines.push(
        `  ${index + 1}. ${candidate.routeId} — excluded (${candidate.reasons.join(", ")})`,
      );
    }
  });
  lines.push(
    "",
    `Provenance: ${provenance.source} @ ${provenance.snapshotTimestamp}`,
  );
  return lines.join("\n");
}

function formatExplainHuman({ result, ranked, provenance, requestSummary }) {
  const lines = [
    `dry-run explain — ${DRY_RUN_LABEL}`,
    `Request: ${requestSummary}`,
    `Evaluation time: ${result.evaluationTime}, max evidence age: ${result.maxEvidenceAgeHours}h`,
    "",
  ];
  for (const candidate of ranked) {
    const detail =
      `provider ${candidate.providerId}, support ${candidate.supportState}, ` +
      formatRate(candidate);
    if (candidate.eligible) {
      lines.push(`${candidate.routeId}: eligible (${detail})`);
    } else {
      lines.push(`${candidate.routeId}: excluded (${detail})`);
      for (const reason of candidate.reasons) {
        lines.push(`  - ${reason}`);
      }
    }
  }
  lines.push(
    "",
    result.status === "selected"
      ? `verdict: selected ${result.selected.routeId}`
      : "verdict: no-eligible-route",
    `Provenance: ${provenance.source} @ ${provenance.snapshotTimestamp}`,
  );
  return lines.join("\n");
}

function formatMachineJson({ command, result, ranked, provenance, evaluationTimeISO, maxEvidenceAgeHours }) {
  return JSON.stringify(
    {
      command,
      // TOG-8326: in-band machine-schema version. Mirrors SCHEMA_VERSION in
      // src/validate-cli-json.js and schema/cli-json/v1.json (`const: v1`);
      // consumers pin on this marker. A shape change bumps the version per
      // docs/cli-json-contract.md, never silently.
      schemaVersion: "v1",
      dryRun: true,
      dryRunLabel: DRY_RUN_LABEL,
      status: result.status,
      selectedRouteId: result.selected?.routeId ?? null,
      policy: result.policy,
      rateDisclaimer: result.rateDisclaimer,
      provenance,
      request: result.request,
      evaluationTime: evaluationTimeISO,
      maxEvidenceAgeHours,
      rankedCandidates: ranked.map((candidate, index) => ({
        rank: index + 1,
        routeId: candidate.routeId,
        providerId: candidate.providerId,
        modelId: candidate.modelId,
        supportState: candidate.supportState,
        eligible: candidate.eligible,
        estimatedRatePerMillion: estimatedRatePerMillion(candidate),
        reasons: [...candidate.reasons],
      })),
    },
    null,
    2,
  );
}

// TOG-5857 (S1): typed requirements render on the explain Request line
// only when actually set — legacy boolean-only requests keep the exact
// pre-S1 line the cli tests pin.
function formatTypedRequirementsSummary(requirements) {
  if (!requirements || Object.keys(requirements).length === 0) {
    return null;
  }
  const parts = [];
  for (const [key, values] of [
    ["inputModalities", requirements.inputModalities],
    ["outputModalities", requirements.outputModalities],
  ]) {
    if (Array.isArray(values) && values.length > 0) {
      parts.push(`${key}=[${[...values].join(", ")}]`);
    }
  }
  for (const key of ["minContextWindow", "maxOutputTokens"]) {
    if (requirements[key] !== null && requirements[key] !== undefined) {
      parts.push(`${key}=${requirements[key]}`);
    }
  }
  for (const key of ["toolCalling", "structuredOutput", "reasoning"]) {
    if (requirements[key] === true) {
      parts.push(key);
    }
  }
  return parts.length > 0 ? parts.join(", ") : null;
}

function formatRequestSummary(selection) {
  const required = selection.requiredCapabilities ?? [];
  const allowlist = selection.providerAllowlist ?? [];
  const typed = formatTypedRequirementsSummary(selection.requirements);
  return (
    `operation=${selection.operation}, ` +
    `require=[${[...required].join(", ")}], ` +
    `allow=[${[...allowlist].join(", ")}]` +
    (typed === null ? "" : `, typed=[${typed}]`)
  );
}

async function runSelectCommand(command, tokens) {
  const options = parseCommandArgs(tokens, command);
  if (options.help) {
    printCommandHelp(command);
    return;
  }
  const {
    selection,
    evaluationTime,
    maxEvidenceAgeMs,
    maxEvidenceAgeHours,
    maxCatalogAgeMs,
  } = await resolveSelectionInput(options);
  const [catalogFixture, configuration] = await Promise.all([
    readJsonFile(options.catalog),
    readJsonFile(options.configuration),
  ]);

  const catalog = normalizeCatalog(catalogFixture.catalog, catalogFixture.provenance);
  const candidates = applySupportConfiguration(catalog, configuration);
  const selectionResult = selectRoute(candidates, selection, {
    now: evaluationTime,
    maxEvidenceAgeMs,
    catalog,
    maxCatalogAgeMs,
  });
  const ranked = rankCandidates(selectionResult.candidates);
  const evaluationTimeISO = evaluationTime.toISOString();

  const view = {
    result: {
      ...selectionResult,
      evaluationTime: evaluationTimeISO,
      maxEvidenceAgeHours,
    },
    ranked,
    provenance: catalog.provenance,
    requestSummary: formatRequestSummary(selectionResult.request),
    evaluationTimeISO,
    maxEvidenceAgeHours,
  };

  if (options.json) {
    process.stdout.write(`${formatMachineJson({ command, ...view })}\n`);
  } else if (command === "select") {
    process.stdout.write(`${formatSelectHuman(view)}\n`);
  } else {
    process.stdout.write(`${formatExplainHuman(view)}\n`);
  }

  process.exitCode =
    selectionResult.status === "selected" ? EXIT_OK : EXIT_NO_ELIGIBLE_ROUTE;
}

async function readVersion() {
  try {
    const pkg = JSON.parse(
      await readFile(new URL("../package.json", import.meta.url), "utf8"),
    );
    return typeof pkg.version === "string" ? pkg.version : "0.0.0";
  } catch {
    return "0.0.0";
  }
}

function printGlobalHelp() {
  process.stdout.write(
    `wayselect — fixture-only dry-run model selection (${DRY_RUN_LABEL})

Usage:
  wayselect select [options]    Select a route and show ranked candidates
  wayselect explain [options]   Explain per-candidate eligibility in detail
  wayselect catalog import ...  Ingest models.dev-shaped JSON into a catalog document
  wayselect --help              Show this help
  wayselect --version           Show the version

Without a subcommand, wayselect runs the legacy fixture demo (JSON with
provenance, selection, and fake transport) for backward compatibility:

  wayselect [--catalog <path>] [--configuration <path>] [--request <path>]
      [--max-catalog-age-hours <n>]

Options for select and explain:
  --catalog <path>               Catalog fixture (default: ${DEFAULT_PATHS.catalog})
  --configuration <path>         Support configuration (default: ${DEFAULT_PATHS.configuration})
  --request <path>               Request JSON: a full demo request or a bare
                                 selection {operation, requiredCapabilities,
                                 providerAllowlist, requirements} (default:
                                 ${DEFAULT_PATHS.request} when no requirement
                                 flags are given)
  --operation <name>             Override the requested operation
  --require <cap,...>            Override required capabilities (repeatable,
                                 comma-separated)
  --allow <provider,...>         Override the provider allowlist (repeatable,
                                 comma-separated)
  --input-modalities <m,...>     Require input modalities (repeatable,
                                 comma-separated; e.g. text,image)
  --output-modalities <m,...>    Require output modalities (repeatable,
                                 comma-separated; e.g. text)
  --min-context-window <n>       Require at least <n> context-window tokens
                                 (unknown limits fail closed)
  --max-output-tokens <n>        Require at least <n> max-output tokens
                                 (unknown limits fail closed)
  --require-tools                Require tool calling (unknown data fails closed)
  --require-structured-output    Require structured output (unknown data fails closed)
  --require-reasoning            Require reasoning (unknown data fails closed)
  --evaluation-time <iso>        Override the evaluation timestamp
  --max-evidence-age-hours <n>   Override the evidence freshness limit
                                 (default: ${DEFAULT_MAX_EVIDENCE_AGE_HOURS})
  --max-catalog-age-hours <n>    Override the catalog freshness limit
                                 (default: ${DEFAULT_MAX_CATALOG_AGE_HOURS};
                                 stale/future catalogs fail closed)
  --json                         Machine-readable JSON output
  --help                         Show command help

Exit codes:
  0  a route was selected (or help/version shown)
  1  invalid input (unreadable file, bad JSON, failed validation)
  2  usage error (unknown subcommand or flag, missing value)
  3  no eligible route (output is still printed)

Examples:
  wayselect select
  wayselect select --operation chat --require toolUse --allow northstar,orbit
  wayselect explain --json
  wayselect select --request fixtures/request.synthetic.json --json
  wayselect catalog import models.json --out catalog.json

See docs/cli.md for copy-pasteable examples.
`,
  );
}

function printCommandHelp(command) {
  const verb = command === "select" ? "Select" : "Explain";
  process.stdout.write(
    `wayselect ${command} — ${verb.toLowerCase()} a route, dry-run only (${DRY_RUN_LABEL})

Usage:
  wayselect ${command} [--catalog <path>] [--configuration <path>] [--request <path>]
      [--operation <name>] [--require <cap,...>] [--allow <provider,...>]
      [--input-modalities <m,...>] [--output-modalities <m,...>]
      [--min-context-window <n>] [--max-output-tokens <n>]
      [--require-tools] [--require-structured-output] [--require-reasoning]
      [--evaluation-time <iso>] [--max-evidence-age-hours <n>]
      [--max-catalog-age-hours <n>] [--json]

Requirements come from --request or from flags; flags override the file.
Typed requirements filter catalog entries; unknown or missing capability
data fails closed (excluded, never silently included).
Stale/future catalogs fail closed (no eligible route, exit 3).
Exit codes: 0 selected, 1 invalid input, 2 usage error, 3 no eligible route.
`,
  );
}

async function main() {
  const argv = process.argv.slice(2);
  const [first] = argv;

  if (first === "select" || first === "explain") {
    try {
      await runSelectCommand(first, argv.slice(1));
    } catch (error) {
      if (error instanceof UsageError) {
        process.stderr.write(`usage error: ${error.message}\n`);
        process.exitCode = EXIT_USAGE;
        return;
      }
      process.stderr.write(`error: ${error.message}\n`);
      process.exitCode = EXIT_INVALID_INPUT;
    }
    return;
  }

  if (first === "catalog") {
    try {
      const options = parseCatalogImportArgs(argv.slice(1));
      if (options.help) {
        printCatalogImportHelp();
        return;
      }
      await runCatalogImport(options);
    } catch (error) {
      process.stderr.write(formatCliFailure(error));
      process.exitCode = 1;
    }
    return;
  }

  if (first === "--help") {
    printGlobalHelp();
    return;
  }
  if (first === "--version") {
    process.stdout.write(`wayselect ${await readVersion()}\n`);
    return;
  }

  // A bare word is neither a subcommand nor a legacy flag: usage error.
  // Legacy `--flag` invocations (and no args) keep the exact demo surface.
  if (first !== undefined && !first.startsWith("--")) {
    process.stderr.write(
      `usage error: Unknown subcommand: ${first}\nRun "wayselect --help" for usage.\n`,
    );
    process.exitCode = EXIT_USAGE;
    return;
  }

  try {
    await runLegacyDemo(argv);
  } catch (error) {
    process.stderr.write(formatCliFailure(error));
    process.exitCode = 1;
  }
}

main();
