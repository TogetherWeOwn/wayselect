#!/usr/bin/env node

// Local pre-push check for Wayselect (TOG-5049; parity audit TOG-7319).
//
// Scope: content only — no workflow or permission change. This script never
// installs hooks, never touches .git/hooks, and never edits CI. Hook install
// is a manual, local-only opt-in documented in docs/pre-push-check.md.
//
// What it runs (stdlib only, no new dependencies) — one gate per CI job in
// .github/workflows/ci.yml plus the acceptance workflow's local steps, so a
// green pre-push predicts a green CI:
//   1. Engine gate (exact CI step: node bin/check-node-engines)
//   2. node --check over every shipped JS/MJS entry (lint/parse gate)
//   3. JSON.parse over every tracked JSON tree (package, fixtures, schema,
//      test fixtures/golden, snapshots, evals, evidence files)
//   4. Structural parse of every .github/workflows/*.yml (tabs, required
//      keys; full YAML load via python3+pyyaml only when already present)
//   5. npm test (node --test suite — the CI `test` job)
//   6. Debt-marker gate (exact CI step: node bin/check-no-todo-markers)
//   7. Ingestion smoke + search-index probe (exact CI steps: npm run smoke,
//      npm run check:search-index)
//   8. E2E staging acceptance (evidence to a temp dir, repo stays clean) +
//      demo CLI run (the acceptance workflow's local steps)
//
// Intentionally not run locally: `npm ci` (CI's clean-install step; the
// local gate uses the existing node_modules) and the acceptance script's
// clean-clone mode (scripts/acceptance.sh <ref> clones the repo; the local
// gate verifies the working tree in place, which is what gets pushed).
//
// Usage:
//   node bin/pre-push-check        # full gate, exit 0 = push-ready
//   npm run pre-push               # same gate via package script
//
// Exit code: 0 when every step passes, 1 otherwise.

import { execFileSync, spawnSync } from "node:child_process";
import { readdirSync, readFileSync, existsSync, statSync, mkdtempSync } from "node:fs";
import { tmpdir } from "node:os";
import { join, relative, resolve, sep } from "node:path";

const ROOT = resolve(new URL(".", import.meta.url).pathname, "..");
const results = [];

function record(status, id, label, detail = "") {
  results.push({ status, id, label, detail });
  const suffix = detail ? ` — ${detail}` : "";
  process.stdout.write(`${status.toUpperCase()} ${id} — ${label}${suffix}\n`);
}

function pass(id, label) {
  record("pass", id, label);
  return true;
}

function fail(id, label, detail = "") {
  record("fail", id, label, detail);
  return false;
}

// Directories never scanned: version control, installed dependencies,
// coverage output, and ephemeral Paperclip runtime scratch.
const SKIP_DIRS = new Set([".git", "node_modules", "coverage", ".paperclip-runtime"]);

function walk(dir, exts, out) {
  let entries;
  try {
    entries = readdirSync(dir, { withFileTypes: true });
  } catch {
    return out;
  }
  entries.sort((a, b) => (a.name < b.name ? -1 : 1));
  for (const entry of entries) {
    // Skip symlinks entirely: never follow them out of the tree.
    if (entry.isSymbolicLink()) continue;
    const abs = join(dir, entry.name);
    if (entry.isDirectory()) {
      if (!SKIP_DIRS.has(entry.name)) walk(abs, exts, out);
    } else if (entry.isFile() && exts.some((ext) => entry.name.endsWith(ext))) {
      out.push(abs);
    }
  }
  return out;
}

function rel(abs) {
  return relative(ROOT, abs).split(sep).join("/");
}

let ok = true;

// ---- P1: engine gate (exact CI step) ----
process.stdout.write("RUN P1 — node bin/check-node-engines\n");
{
  const engine = spawnSync(process.execPath, ["bin/check-node-engines"], {
    cwd: ROOT,
    stdio: "inherit",
    shell: process.platform === "win32",
  });
  if (engine.status === 0) {
    pass("P1", "engine gate clean");
  } else {
    ok = fail("P1", "engine gate failed", `exit ${engine.status}`) && ok;
  }
}

// ---- P2: node --check over shipped JS/MJS (recursive) ----
const JS_DIRS = ["src", "test", "web", "support", "scripts", "evals"];
const targets = [];
const binDir = join(ROOT, "bin");
if (existsSync(binDir)) {
  for (const entry of readdirSync(binDir).sort()) {
    const abs = join(binDir, entry);
    let firstLine = "";
    try {
      if (!statSync(abs).isFile()) continue;
      firstLine = readFileSync(abs, "utf8").split("\n")[0] ?? "";
    } catch {
      continue;
    }
    if (firstLine.includes("node")) targets.push(`bin/${entry}`);
  }
}
for (const dir of JS_DIRS) {
  const abs = join(ROOT, dir);
  if (!existsSync(abs)) continue;
  for (const found of walk(abs, [".js", ".mjs"], [])) targets.push(rel(found));
}
targets.sort();
let checkFailed = [];
for (const target of targets) {
  try {
    execFileSync(process.execPath, ["--check", join(ROOT, target)], { stdio: "pipe" });
  } catch {
    checkFailed.push(target);
  }
}
if (checkFailed.length === 0) {
  pass("P2", `node --check clean (${targets.length} files)`);
} else {
  ok = fail("P2", "node --check failures", checkFailed.join(", ")) && ok;
}

// ---- P3: JSON parse over every tracked JSON tree ----
const jsonTargets = walk(ROOT, [".json"], []).map((abs) => rel(abs)).sort();
const jsonBad = [];
for (const target of jsonTargets) {
  try {
    JSON.parse(readFileSync(join(ROOT, target), "utf8"));
  } catch (error) {
    jsonBad.push(`${target} (${error.message})`);
  }
}
if (jsonBad.length === 0) {
  pass("P3", `JSON parse clean (${jsonTargets.length} files)`);
} else {
  ok = fail("P3", "JSON parse failures", jsonBad.join("; ")) && ok;
}

// ---- P4: CI workflow YAML structural parse (every workflow file) ----
// No yaml dependency in this repo (stdlib only by design). This gate does a
// deterministic structural check that catches the common push-breakers
// (tabs, missing top-level keys, empty file). When python3+pyyaml happens to
// be installed locally it additionally runs a real yaml.safe_load; absence
// of python/yaml is not a failure.
const workflowsDir = join(ROOT, ".github", "workflows");
let workflowFiles = [];
try {
  workflowFiles = readdirSync(workflowsDir)
    .filter((entry) => entry.endsWith(".yml") || entry.endsWith(".yaml"))
    .sort()
    .map((entry) => `.github/workflows/${entry}`);
} catch {
  workflowFiles = [];
}
if (workflowFiles.length === 0) {
  ok = fail("P4", "CI workflows missing", ".github/workflows/") && ok;
} else {
  const problems = [];
  let safeLoadCount = 0;
  let yamlAvailable = null;
  for (const workflowRel of workflowFiles) {
    const text = readFileSync(join(ROOT, workflowRel), "utf8");
    if (text.trim().length === 0) problems.push(`${workflowRel}: empty file`);
    if (/\t/.test(text)) problems.push(`${workflowRel}: tab indentation found (YAML requires spaces)`);
    for (const key of ["name:", "on:", "jobs:"]) {
      if (!text.includes(key)) problems.push(`${workflowRel}: missing required key ${key}`);
    }
    try {
      execFileSync(
        "python3",
        ["-c", "import yaml,sys; yaml.safe_load(open(sys.argv[1]))", join(ROOT, workflowRel)],
        { stdio: "pipe" },
      );
      safeLoadCount += 1;
      yamlAvailable = true;
    } catch {
      // safe_load failed or python/yaml unavailable. Re-probe: if
      // `import yaml` succeeds, yaml exists so the failure is a real parse
      // error; otherwise python3 or pyyaml is simply absent (not a failure).
      try {
        execFileSync("python3", ["-c", "import yaml"], { stdio: "pipe" });
        problems.push(`${workflowRel}: yaml.safe_load failed (see python3 output)`);
        yamlAvailable = true;
      } catch {
        yamlAvailable = yamlAvailable ?? false;
      }
    }
  }
  const yamlNote =
    yamlAvailable === true
      ? `structural + yaml.safe_load (${safeLoadCount}/${workflowFiles.length})`
      : "structural (python3+pyyaml not installed locally — skipped)";
  if (problems.length === 0) {
    pass("P4", `${workflowFiles.length} workflows parse (${yamlNote})`);
  } else {
    ok = fail("P4", "workflow problems", problems.join("; ")) && ok;
  }
}

// ---- P5: test suite (the CI `test` job) ----
process.stdout.write("RUN P5 — npm test\n");
{
  const testRun = spawnSync("npm", ["test", "--silent"], {
    cwd: ROOT,
    stdio: "inherit",
    shell: process.platform === "win32",
  });
  if (testRun.status === 0) {
    pass("P5", "npm test green");
  } else {
    ok = fail("P5", "npm test failed", `exit ${testRun.status}`) && ok;
  }
}

// ---- P6: debt-marker gate (exact CI step) ----
process.stdout.write("RUN P6 — node bin/check-no-todo-markers\n");
{
  const marker = spawnSync(process.execPath, ["bin/check-no-todo-markers"], {
    cwd: ROOT,
    stdio: "inherit",
    shell: process.platform === "win32",
  });
  if (marker.status === 0) {
    pass("P6", "marker gate clean");
  } else {
    ok = fail("P6", "marker gate failed", `exit ${marker.status}`) && ok;
  }
}

// ---- P7: ingestion smoke + search-index probe (exact CI steps) ----
process.stdout.write("RUN P7 — npm run smoke + npm run check:search-index\n");
{
  const smoke = spawnSync("npm", ["run", "smoke", "--silent"], {
    cwd: ROOT,
    stdio: "inherit",
    shell: process.platform === "win32",
  });
  const probe = smoke.status === 0
    ? spawnSync("npm", ["run", "check:search-index", "--silent"], {
      cwd: ROOT,
      stdio: "inherit",
      shell: process.platform === "win32",
    })
    : null;
  if (smoke.status === 0 && probe && probe.status === 0) {
    pass("P7", "smoke + search-index probe green");
  } else if (smoke.status !== 0) {
    ok = fail("P7", "ingestion smoke failed", `exit ${smoke.status}`) && ok;
  } else {
    ok = fail("P7", "search-index probe failed", `exit ${probe.status}`) && ok;
  }
}

// ---- P8: e2e staging acceptance + demo (acceptance workflow local steps) ----
process.stdout.write("RUN P8 — e2e staging acceptance + demo\n");
{
  const evidenceDir = mkdtempSync(join(tmpdir(), "wayselect-pre-push-e2e-"));
  const e2e = spawnSync(
    process.execPath,
    ["scripts/e2e-staging-acceptance.mjs", "--out", join(evidenceDir, "e2e-evidence.json")],
    { cwd: ROOT, stdio: "inherit", shell: process.platform === "win32" },
  );
  const demo = e2e.status === 0
    ? spawnSync("npm", ["run", "demo", "--silent"], {
      cwd: ROOT,
      stdio: "inherit",
      shell: process.platform === "win32",
    })
    : null;
  if (e2e.status === 0 && demo && demo.status === 0) {
    pass("P8", "e2e acceptance + demo green");
  } else if (e2e.status !== 0) {
    ok = fail("P8", "e2e staging acceptance failed", `exit ${e2e.status}`) && ok;
  } else {
    ok = fail("P8", "demo failed", `exit ${demo.status}`) && ok;
  }
}

const passCount = results.filter((r) => r.status === "pass").length;
const failCount = results.filter((r) => r.status === "fail").length;
process.stdout.write(`SUMMARY: ${passCount} pass, ${failCount} fail — pre-push ${ok ? "READY" : "NOT READY"}\n`);
process.exitCode = ok ? 0 : 1;
