#!/usr/bin/env node

// Executable QA acceptance for capability-aware dry-run select (TOG-5860,
// S4 of docs/acceptance-spec-capability-select.md).
//
// Usage: node bin/accept-wayselect-capability-select
//    (or: npm run accept:capability-select)
// Zero dependencies: Node standard library only. Runs the A1–A7 golden suite
// (test/capability-select-golden.test.js) against the current CLI with small
// newly-authored fixtures only — no network, no redistributed catalog
// snapshot. Exits 0 when the goldens are green, 1 otherwise.
// Budget: under 15 minutes (typically < 10s).

import { spawnSync } from "node:child_process";
import { resolve } from "node:path";
import { fileURLToPath } from "node:url";

const REPO_ROOT = resolve(fileURLToPath(new URL(".", import.meta.url)), "..");
const BUDGET_MS = 15 * 60 * 1000;
const startedAt = Date.now();

const result = spawnSync(
  process.execPath,
  ["--test", "test/capability-select-golden.test.js"],
  { cwd: REPO_ROOT, stdio: "inherit" },
);

const elapsedS = ((Date.now() - startedAt) / 1000).toFixed(1);
const overBudget = Date.now() - startedAt > BUDGET_MS;
if (overBudget) {
  process.stdout.write("FAIL BUDGET — run exceeded the 15-minute budget\n");
}
process.stdout.write(`SUMMARY: capability-select goldens A1–A7 — ${elapsedS}s (budget 15m)\n`);
process.exitCode = result.status === 0 && !overBudget ? 0 : 1;
