{
  "name": "wayselect",
  "version": "0.1.0",
  "private": true,
  "description": "Explainable model selection with models.dev catalog discovery and explicit capability checks.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wayselect": "bin/wayselect",
    "wayselect-snapshot": "bin/wayselect-snapshot",
    "wayselect-search-index-refresh": "bin/wayselect-search-index-refresh"
  },
  "scripts": {
    "demo": "node bin/wayselect",
    "test": "node --test test/*.test.js",
    "preview": "node web/server.js",
    "accept:web": "node bin/accept-wayselect-web",
    "accept:search-filter": "node bin/accept-wayselect-search-filter",
    "accept:seller": "node bin/accept-wayselect-seller",
    "accept:seller-payout": "node bin/accept-wayselect-seller-payout",
    "accept:buyer": "node bin/accept-wayselect-buyer",
    "accept:payout": "node bin/accept-wayselect-payout",
    "accept:eligibility": "node bin/accept-wayselect-eligibility",
    "accept:dryrun-explain": "node bin/accept-wayselect-dryrun-explain",
    "accept:checkout": "node bin/accept-wayselect-checkout",
    "snapshot": "node bin/wayselect-snapshot",
    "check:provenance": "node bin/check-ingestion-provenance",
    "smoke": "node bin/smoke-wayselect-ingestion",
    "preview:health": "node bin/check-preview-health",
    "refresh": "node bin/refresh-catalog-fixtures",
    "refresh:check": "node bin/refresh-catalog-fixtures --check",
    "eval:search-prompts": "node bin/eval-wayselect-search-prompts --seed 5492",
    "accept:fixture-refresh": "node bin/accept-fixture-refresh",
    "refresh:search-index": "node bin/wayselect-search-index-refresh",
    "check:search-index": "node bin/wayselect-search-index-refresh --check --max-catalog-age-hours 24",
    "probe:models-dev": "node bin/check-models-dev-freshness"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "escape-html": "1.0.3"
  }
}
