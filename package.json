{
  "name": "wayselect",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Explainable model selection with models.dev catalog discovery and explicit capability checks.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wayselect": "bin/wayselect",
    "wayselect-snapshot": "bin/wayselect-snapshot",
    "wayselect-snapshot-prune": "bin/wayselect-snapshot-prune",
    "wayselect-search-index-refresh": "bin/wayselect-search-index-refresh"
  },
  "scripts": {
    "demo": "node bin/wayselect",
    "test": "node --test --import ./support/no-network-guard.js test/*.test.js",
    "preview": "node web/server.js",
    "accept:web": "node bin/accept-wayselect-web",
    "accept:search-filter": "node bin/accept-wayselect-search-filter",
    "accept:seller": "node bin/accept-wayselect-seller",
    "accept:seller-payout": "node bin/accept-wayselect-seller-payout",
    "accept:buyer": "node bin/accept-wayselect-buyer",
    "accept:buyer-listing": "node bin/accept-wayselect-buyer-listing",
    "accept:payout": "node bin/accept-wayselect-payout",
    "accept:eligibility": "node bin/accept-wayselect-eligibility",
    "accept:capability-select": "node bin/accept-wayselect-capability-select",
    "accept:dryrun-explain": "node bin/accept-wayselect-dryrun-explain",
    "accept:checkout": "node bin/accept-wayselect-checkout",
    "accept:gateway-phase1": "node bin/accept-wayselect-gateway-phase1",
    "accept:trust": "node bin/accept-wayselect-trust",
    "accept:all": "node bin/accept-wayselect-web && node bin/accept-wayselect-search-filter && node bin/accept-wayselect-seller && node bin/accept-wayselect-seller-payout && node bin/accept-wayselect-buyer && node bin/accept-wayselect-buyer-listing && node bin/accept-wayselect-payout && node bin/accept-wayselect-eligibility && node bin/accept-wayselect-capability-select && node bin/accept-wayselect-dryrun-explain && node bin/accept-wayselect-checkout && node bin/accept-wayselect-gateway-phase1 && node bin/accept-wayselect-trust && node bin/accept-fixture-refresh",
    "snapshot": "node bin/wayselect-snapshot",
    "prune:snapshots": "node bin/wayselect-snapshot-prune",
    "check:provenance": "node bin/check-ingestion-provenance",
    "smoke": "node bin/smoke-wayselect-ingestion",
    "smoke:staging-preview": "node bin/smoke-wayselect-staging-preview",
    "preview:health": "node bin/check-preview-health",
    "refresh": "node bin/refresh-catalog-fixtures",
    "refresh:check": "node bin/refresh-catalog-fixtures --check",
    "check:drift": "node bin/check-provenance-drift",
    "eval:search-prompts": "node bin/eval-wayselect-search-prompts --seed 5492",
    "accept:fixture-refresh": "node bin/accept-fixture-refresh",
    "accept:snapshot-restore": "node bin/accept-snapshot-restore",
    "bench:large-catalog": "node bin/benchmark-large-catalog",
    "refresh:search-index": "node bin/wayselect-search-index-refresh",
    "check:search-index": "node bin/wayselect-search-index-refresh --check --max-catalog-age-hours 24",
    "probe:models-dev": "node bin/check-models-dev-freshness",
    "pre-push": "node bin/pre-push-check",
    "acceptance": "scripts/acceptance.sh"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "escape-html": "1.0.3"
  }
}
